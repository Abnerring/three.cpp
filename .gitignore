# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug artifacts
*.pdb
*.ilk

# Build directories
/build/
/build-*/
/cmake-build-*/
/out/

# Local IDE configuration
/.vs/
.vscode/

# Vendored Vulkan SDK (headers + glslang). The rules above ignore *.dll/*.exe/*.lib
# for build output, but these files are checked in on purpose so a clean checkout
# builds the renderer without installing the SDK.
!third_party/vulkan/bin/*.exe
!third_party/vulkan/bin/*.dll
