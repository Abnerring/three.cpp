# Development test launcher only. Existing comparators and native assertions
# own all semantic checks; this script provides a fresh evidence path per run.
foreach(required IN ITEMS NODE PROBE COMPARATOR MODE OUTPUT_ROOT SUITE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing native alignment argument: ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(output "${OUTPUT_ROOT}/${SUITE}-${stamp}-${suffix}")
if(EXISTS "${output}")
    message(FATAL_ERROR "Evidence path collision: ${output}")
endif()
set(command "${NODE}" --expose-gc "${COMPARATOR}")
if(MODE STREQUAL "POSITIONAL")
    list(APPEND command "${PROBE}" "${output}")
elseif(MODE STREQUAL "TSL")
    list(APPEND command "${UPSTREAM}" "${PROBE}" "${output}")
elseif(MODE STREQUAL "NAMED_UPSTREAM")
    list(APPEND command --probe "${PROBE}" --upstream "${UPSTREAM}" --output "${output}")
elseif(MODE STREQUAL "VULKAN")
    list(APPEND command --probe "${PROBE}" --output "${output}")
elseif(MODE STREQUAL "VULKAN_HALF")
    if(NOT EXISTS "${EXPECTED}")
        message(FATAL_ERROR "Pinned HalfFloat encoding fixture is missing: ${EXPECTED}")
    endif()
    list(APPEND command --probe "${PROBE}" --expected "${EXPECTED}" --output "${output}")
else()
    message(FATAL_ERROR "Unknown native alignment CLI mode: ${MODE}")
endif()
message(STATUS "Native alignment evidence: ${output}")
execute_process(COMMAND ${command} RESULT_VARIABLE status)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Native alignment ${SUITE} failed (${status}); preserve evidence at ${output}")
endif()
